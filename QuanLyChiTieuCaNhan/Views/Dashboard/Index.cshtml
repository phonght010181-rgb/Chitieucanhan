@model QuanLyChiTieuCaNhan.ViewModels.DashboardViewModel
@{
    ViewBag.Title = "Tổng quan";
}

<div class="page-heading">
    <div>
        <h1>Tổng quan tài chính</h1>
        <p class="text-muted mb-0">Theo dõi thu chi và ngân sách tháng @DateTime.Now.Month/@DateTime.Now.Year.</p>
    </div>
    <a asp-controller="Transaction" asp-action="Create" class="btn btn-primary mt-2"><i class="fi fi-rr-plus mr-1" aria-hidden="true"></i> Thêm giao dịch</a>
</div>

<!-- 3 thẻ tóm tắt -->
<div class="row">
    <div class="col-md-4">
        <div class="card stat-card income">
            <div class="stat-icon"><i class="fi fi-rr-arrow-down-left" aria-hidden="true"></i></div>
            <div>
                <div class="stat-label">Tổng thu tháng</div>
                <div class="stat-value">@Model.TotalIncome.ToString("N0") <small>VND</small></div>
                <span class="stat-note">Tháng @DateTime.Now.Month/@DateTime.Now.Year</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card expense">
            <div class="stat-icon"><i class="fi fi-rr-arrow-up-right" aria-hidden="true"></i></div>
            <div>
                <div class="stat-label">Tổng chi tháng</div>
                <div class="stat-value">@Model.TotalExpense.ToString("N0") <small>VND</small></div>
                <span class="stat-note">Tháng @DateTime.Now.Month/@DateTime.Now.Year</span>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card">
            <div class="stat-icon"><i class="fi fi-rr-wallet" aria-hidden="true"></i></div>
            <div>
                <div class="stat-label">Số dư ròng tháng</div>
                <div class="stat-value @(Model.NetBalance >= 0 ? "" : "text-danger")">
                    @Model.NetBalance.ToString("N0") <small>VND</small>
                </div>
                <span class="stat-note">Chênh lệch thu và chi</span>
            </div>
        </div>
    </div>
</div>

<!-- Biểu đồ -->
<div class="row mb-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white font-weight-bold">
                <i class="fi fi-rr-chart-pie"></i> Chi tiêu theo danh mục
            </div>
            <div class="card-body chart-body">
                @if (Model.ExpenseByCategory.Any())
                {
                    <canvas id="expenseChart" height="300"></canvas>
                }
                else
                {
                    <p class="text-muted text-center py-5">Chưa có dữ liệu chi tiêu tháng này</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white font-weight-bold">
                <i class="fi fi-rr-chart-histogram"></i> Thu – Chi theo tháng (@DateTime.Now.Year)
            </div>
            <div class="card-body chart-body">
                <canvas id="monthlyChart" height="300"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Ngân sách nhanh + Giao dịch gần nhất -->
<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white font-weight-bold">
                <i class="fi fi-rr-chart-pie"></i> Ngân sách tháng này
                @{
                    var overBudgets = Model.TopBudgets.Where(b => b.Percentage > 90).ToList();
                    if (overBudgets.Any())
                    {
                        <span class="badge badge-danger float-right">@overBudgets.Count vượt mức!</span>
                    }
                }
            </div>
            <div class="card-body">
                @if (Model.TopBudgets.Any())
                {
                    foreach (var b in Model.TopBudgets)
                    {
                        var pct = b.Percentage;
                        var barClass = pct > 90 ? "bg-danger" : (pct > 70 ? "bg-warning" : "bg-success");
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="font-weight-bold">@b.CategoryName</small>
                                <small>@b.SpentAmount.ToString("N0") / @b.LimitAmount.ToString("N0")</small>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar @barClass" style="width: @(Math.Min(pct, 100))%"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-3">Chưa có ngân sách</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header card-header-actions bg-white font-weight-bold">
                <span class="card-header-title"><i class="fi fi-rr-list" aria-hidden="true"></i> 10 giao dịch gần nhất</span>
                <a href="@Url.Action("Create", "Transaction")" class="btn btn-sm btn-primary">
                    <i class="fi fi-rr-plus"></i> Thêm mới
                </a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentTransactions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Ngày</th>
                                    <th>Danh mục</th>
                                    <th>Ví</th>
                                    <th class="text-right">Số tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.RecentTransactions)
                                {
                                    var amountClass = t.TransactionType == 1 ? "text-success" : (t.TransactionType == 2 ? "text-danger" : "text-info");
                                    var prefix = t.TransactionType == 1 ? "+" : (t.TransactionType == 2 ? "-" : "↔");
                                    <tr>
                                        <td>@t.TransactionDate.ToString("dd/MM")</td>
                                        <td>@(t.Category != null ? t.Category.Name : "N/A")</td>
                                        <td>@(t.Wallet != null ? t.Wallet.Name : "N/A")</td>
                                        <td class="text-right font-weight-bold @amountClass">@prefix@t.Amount.ToString("N0")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">Chưa có giao dịch nào</p>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Biểu đồ tròn
        @if (Model.ExpenseByCategory.Any())
        {
            <text>
            new Chart(document.getElementById('expenseChart'), {
                type: 'doughnut',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpenseByCategory.Select(e => e.CategoryName))),
                    datasets: [{
                        data: [@Html.Raw(string.Join(",", Model.ExpenseByCategory.Select(e => e.Amount.ToString("F0"))))],
                        backgroundColor: ['#2F2CD8','#0E7CEB','#FBA801','#12A347','#8473ED','#F97066','#7184AD','#55BFA8','#A4B8F5','#E17BB1'],
                        borderWidth: 0,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12 } }
                    }
                }
            });
            </text>
        }

        // Biểu đồ cột
        new Chart(document.getElementById('monthlyChart'), {
            type: 'bar',
            data: {
                labels: [@Html.Raw(string.Join(",", Model.MonthlyIncomeExpense.Select(m => "'T" + m.Month + "'")))],
                datasets: [
                    {
                        label: 'Thu',
                        data: [@Html.Raw(string.Join(",", Model.MonthlyIncomeExpense.Select(m => m.Income.ToString("F0"))))],
                        backgroundColor: '#2F2CD8',
                        borderRadius: 4,
                        maxBarThickness: 22
                    },
                    {
                        label: 'Chi',
                        data: [@Html.Raw(string.Join(",", Model.MonthlyIncomeExpense.Select(m => m.Expense.ToString("F0"))))],
                        backgroundColor: '#b9b7f3',
                        borderRadius: 4,
                        maxBarThickness: 22
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(v) { return v.toLocaleString('vi-VN'); }
                        }
                    }
                },
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
}
